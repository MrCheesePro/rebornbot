        console.log("Code:", code);

        const discordId = linkMC(username, code);
        if (discordId) {
            console.log(`Attempting to whisper to ${username}`);
            bot.chat(`/r Your Discord is now linked!`);
            console.log("LINK SUCCESS");
            console.log(`Linked ${username} to Discord ID ${discordId}`);
